# URL of the IPFS Cluster REST API (reachable via cluster-internal Docker network)
CLUSTER_API_URL=http://cluster:9094

# URL of the failed-CID tracker API (reachable via cluster-internal Docker network)
TRACKER_API_URL=http://tracker:9095

# Cache TTL in milliseconds for cluster API responses (default: 15000)
CACHE_TTL_MS=15000

# Maximum concurrent requests to the cluster API (default: 5)
MAX_CONCURRENT_CLUSTER_REQUESTS=5

# Cluster API request timeout in milliseconds (default: 30000)
CLUSTER_TIMEOUT_MS=10000

# Maximum response body size in bytes (default: 5242880 = 5 MB)
CLUSTER_MAX_RESPONSE_BYTES=5242880

# Default pagination page size for project CID lists (default: 50)
PAGE_SIZE=50

# Domain for Traefik routing (optional)
DOMAIN=dashboard.localhost